{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt vite --host",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
